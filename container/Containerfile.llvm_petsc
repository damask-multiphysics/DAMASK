ARG VERSION
ARG REMOTE
FROM ${REMOTE}/llvm_base:${VERSION}

ARG VARIANT
ARG FLAGS
ENV PETSC_ARCH=llvm_petsc-${VARIANT}

RUN cd petsc && \
    eval ./configure \
    "${FLAGS}" \
    --with-cc=clang --with-cxx=clang++ --with-fc=flang \
    --with-fortran-bindings=1 --with-mpi-ftn-module=mpi_f08 --with-shared-libraries=1 \
    --download-mpich=1 \
    --download-fblaslapack=1 \
    --download-hdf5=1 --with-hdf5-fortran-bindings=1 --with-hdf5-cxx-bindings=1 \
    --download-fftw=1 \
    --download-boost=1 \
    --download-zlib=1 && \
    make && \
    rm -rf ${PETSC_ARCH}/obj && \
    echo ${PETSC_DIR}/${PETSC_ARCH}/lib > /etc/ld.so.conf.d/petsc.conf && \
    ldconfig
