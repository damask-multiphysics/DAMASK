FROM docker.io/ubuntu:rolling

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --no-install-suggests \
    gcc gfortran g++ \
    build-essential cmake ninja-build pkg-config \
    git ca-certificates \
    libgtest-dev clang-tidy clang-format iwyu \
    libopenmpi-dev openmpi-bin \
    libhdf5-dev libhdf5-mpi-dev libfftw3-mpi-dev libfftw3-dev libopenblas-dev \
    libboost-all-dev libeigen3-dev zlib1g-dev libyaml-dev libfyaml-dev \
    python3 python-is-python3 python3-pytest python3-pytest-xdist \
    python3-numpy python3-scipy python3-pandas python3-h5py python3-vtk9 python3-matplotlib python3-yaml && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN git clone --depth=1 -b release https://gitlab.com/petsc/petsc.git
ENV PETSC_DIR=/petsc

ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
