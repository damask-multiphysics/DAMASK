ARG VERSION
ARG REMOTE
FROM ${REMOTE}/oneapi_base:${VERSION}

ARG VARIANT
ARG FLAGS
ENV PETSC_ARCH=oneapi_petsc-${VARIANT}

RUN cd petsc && \
    eval ./configure \
    "${FLAGS}" \
    --with-cc=mpiicx --with-cxx=mpiicpx --with-fc=mpiifx \
    --with-fortran-bindings=1 --with-mpi-ftn-module=mpi_f08 --with-shared-libraries=1 \
    --with-blaslapack-dir=${MKLROOT} \
    --download-hdf5=1 --with-hdf5-fortran-bindings=1 --with-hdf5-cxx-bindings=1 \
    --download-fftw=1 \
    --download-boost=1 \
    --download-zlib=1 && \
    make && \
    rm -rf ${PETSC_ARCH}/obj && \
    echo ${PETSC_DIR}/${PETSC_ARCH}/lib > /etc/ld.so.conf.d/petsc.conf && \
    ldconfig
