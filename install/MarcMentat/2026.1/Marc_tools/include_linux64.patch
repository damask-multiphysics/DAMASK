@@ -1020,6 +1067,6 @@ if test $MPITYPE = intelmpi
  if test "${COMP_ENV}" = "gcc" ; then
  SYSLIBS="$SYSLIBS -lrt $OPENMP -lpthread -shared-libgcc $RPCLIB -ldl "
  else
- SYSLIBS="$SYSLIBS -L${MPI_ROOT}/lib/release -lmpi -L${MPI_ROOT}/lib -lmpifort -lrt $OPENMP -threads -lpthread -shared-intel -cxxlib $RPCLIB"
+ SYSLIBS="$SYSLIBS -L${MPI_ROOT}/lib/release -lmpi -L${MPI_ROOT}/lib -lmpifort -lrt $OPENMP -threads -lpthread -static-intel -cxxlib $RPCLIB"
