@@ -218,6 +218,12 @@ if test -n "$MSCCOSIM_HOME"; then
  MARC_COSIM_LIB="$MSCCOSIM_HOME/CoSim$MSCCOSIM_VERSION/Dcosim$MSCCOSIM_VERSION/lib"
 fi

+# DAMASK uses the HDF5 compiler wrapper around the Intel compiler
+HDF5_LIB=$(h5fc -shlib -show)
+HDF5_LIB=${HDF5_LIB#*ifx}
+HDF5_LIB="$HDF5_LIB -Wl,--disable-new-dtags"
+FCOMP=ifx
+
 # AEM
 if test "$MARCDLLOUTDIR" = ""; then
  DLLOUTDIR="$MARC_LIB"
@@ -717,6 +724,11 @@ CCHIGH="$C_COMP -c $CC_OPT -O3 $I8DEFINES -DLinux -DLINUX -DLinux_intel $CDEFINES $C
 CC_TETMESH="$CP_COMP -c -O2 -I$TETMESHDIR/include ${CC_OPENMP} -ansi-alias -m64 -pipe -fPIC -falign-functions=16 -fstrict-aliasing -fno-jump-tables -MMD -DLINUX -D_CRT_SECURE_NO_WARNINGS -DX64 -DMESHINGAPI_LIB -DNDEBUG"
 CC_CAEFATIGUE="$CP_COMP -c -O2 -I$CAEFATIGUEDIR/linux64/include ${CC_OPENMP} -ansi-alias -m64 -pipe -fPIC -falign-functions=16 -fstrict-aliasing -fno-jump-tables -MMD -DLINUX -D_CRT_SECURE_NO_WARNINGS -DX64 -DNDEBUG"

+# DAMASK compiler calls
+DCCLOW="$C_COMP -c $CC_OPT -O0 $I8DEFINES -DLinux -DLINUX -DLinux_intel -DFYAML -DMARC_SOURCE $CDEFINES $CINCL $SOLVERFLAGS $OPENSSL_INCLUDE "
+DCC="$C_COMP -c $CC_OPT -O1 $I8DEFINES -DLinux -DLINUX -DLinux_intel -DFYAML -DMARC_SOURCE $CDEFINES $CINCL $SOLVERFLAGS $OPENSSL_INCLUDE -I$MPI_ROOT/include"
+DCCHIGH="$C_COMP -c $CC_OPT -O3 $I8DEFINES -DLinux -DLINUX -DLinux_intel -DFYAML -DMARC_SOURCE $CDEFINES $CINCL $SOLVERFLAGS $OPENSSL_INCLUDE "
+
 if test "$MARCDEBUG" = "ON"
 then
   CC="$C_COMP -c $CC_OPT -DLinux $I8DEFINES -DLINUX -DLinux_intel $CDEFINES $CINCL $SOLVERFLAGS $OPENSSL_INCLUDE -I$MPI_ROOT/include "
@@ -754,7 +766,7 @@
 if test "${COMP_ENV}" = "gcc" ; then
   FORT_OPT="-c -cpp -fcray-pointer -fallow-argument-mismatch -fd-lines-as-comments -Wno-missing-include-dirs -Wno-argument-mismatch -std=legacy -D_GCC_PORTING_PATCH_"
 else
-  FORT_OPT="-c -assume byterecl -safe-cray-ptr -WB -fp-model source -diag-disable:10448"
+  FORT_OPT="-c -implicitnone -stand f18 -standard-semantics -assume nostd_mod_proc_name -safe-cray-ptr -WB -fp-model source -diag-disable:10448"
 fi
 if test "$MTHREAD" = "OPENMP"
 then
@@ -771,7 +783,7 @@ else
   fi
 fi
 if test "$MARCHDF_HDF" = "HDF"; then
